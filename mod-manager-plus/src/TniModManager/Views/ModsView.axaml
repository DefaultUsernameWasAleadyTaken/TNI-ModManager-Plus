<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TniModManager.ViewModels"
             xmlns:controls="using:TniModManager.Controls"
             x:Class="TniModManager.Views.ModsView"
             x:DataType="vm:ModsViewModel">

  <controls:MasterDetailPanel Margin="0,8,0,0"
                              SidebarMinWidth="240"
                              VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <controls:MasterDetailPanel.SidebarContent>
      <!-- Ширину колонки задаёт FilterBar (чипы по тексту); см. ModsView.axaml.cs -->
      <Grid x:Name="SidebarRoot" RowDefinitions="Auto,Auto,Auto,*" Margin="14"
            HorizontalAlignment="Left">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBlock Text="{DynamicResource L.Library}" Classes="section" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="{DynamicResource L.Refresh}" Classes="ghost"
                  Command="{Binding RefreshModsCommand}" Padding="9,5"/>
        </Grid>

        <TextBox Grid.Row="1" Watermark="{DynamicResource L.SearchMods}"
                 Text="{Binding ModFilter}" Margin="0,0,0,10"/>

        <StackPanel x:Name="FilterBar" Grid.Row="2" Orientation="Horizontal" Spacing="6"
                    Margin="0,0,0,10" HorizontalAlignment="Left">
          <RadioButton Content="{DynamicResource L.FilterAll}" Classes="filter" GroupName="Filter"
                       HorizontalAlignment="Left"
                       IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                       Command="{Binding SetFilterCommand}" CommandParameter="All"/>
          <RadioButton Content="{DynamicResource L.FilterInstalled}" Classes="filter" GroupName="Filter"
                       HorizontalAlignment="Left"
                       IsChecked="{Binding IsFilterInstalled, Mode=OneWay}"
                       Command="{Binding SetFilterCommand}" CommandParameter="Installed"/>
          <RadioButton Content="{DynamicResource L.FilterAvailable}" Classes="filter" GroupName="Filter"
                       HorizontalAlignment="Left"
                       IsChecked="{Binding IsFilterAvailable, Mode=OneWay}"
                       Command="{Binding SetFilterCommand}" CommandParameter="Available"/>
        </StackPanel>

        <ListBox Grid.Row="3" ItemsSource="{Binding VisibleMods}"
                 SelectedItem="{Binding SelectedModItem}" Classes="dense-list">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ModListItemViewModel">
              <Border BorderBrush="{Binding BorderBrush}" BorderThickness="3,0,0,0"
                      Padding="10,7" Background="Transparent">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SourceLabel}" Classes="muted" FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Border Grid.Column="1" Background="{DynamicResource UpdateBadgeBgBrush}"
                          CornerRadius="{DynamicResource RadiusSm}" Padding="7,2"
                          IsVisible="{Binding ShowUpdateBadge}"
                          VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{DynamicResource L.UpdateBadge}" FontSize="10"
                               Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold"/>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </controls:MasterDetailPanel.SidebarContent>

    <controls:MasterDetailPanel.DetailContent>
      <Grid ClipToBounds="True">
        <StackPanel IsVisible="{Binding !HasSelectedMod}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
          <TextBlock Text="{DynamicResource L.NothingSelected}" FontSize="18" FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource MutedBrush}"/>
          <TextBlock Text="{DynamicResource L.PickMod}"
                     Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap"
                     TextAlignment="Center" MaxWidth="320"/>
        </StackPanel>

        <Grid IsVisible="{Binding HasSelectedMod}" RowDefinitions="Auto,*" ClipToBounds="True">
          <!-- Sticky actions -->
          <Border Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                  Padding="20,16,20,12">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding ModNameText}" FontSize="20" FontWeight="SemiBold"
                         TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border Background="{Binding ModSourceBrush}"
                          CornerRadius="{DynamicResource RadiusSm}" Padding="10,4"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModSourceText}"
                               Foreground="{DynamicResource OnAccentBrush}"
                               FontSize="11" FontWeight="SemiBold"/>
                  </Border>
                  <Border Background="{DynamicResource Surface2Brush}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource RadiusSm}" Padding="10,4"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModVersionBadgeText}" Classes="muted" FontSize="11"/>
                  </Border>
                </StackPanel>
                <WrapPanel Grid.Column="1" Orientation="Horizontal"
                           HorizontalAlignment="Right">
                  <Button Content="{DynamicResource L.GitHub}" Classes="secondary mod-action"
                          IsVisible="{Binding ShowGitHub}" Margin="0,0,6,6"
                          Command="{Binding OpenModGitHubCommand}"/>
                  <Button Classes="success mod-action" IsVisible="{Binding ShowDownload}"
                          Margin="0,0,6,6" Command="{Binding DownloadSelectedCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Width="12" Height="12"
                                Foreground="{DynamicResource OnSuccessBrush}"
                                Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
                      <TextBlock Text="{DynamicResource L.Download}" FontSize="11"
                                 Foreground="{DynamicResource OnSuccessBrush}"/>
                    </StackPanel>
                  </Button>
                  <Button Classes="warn mod-action" IsVisible="{Binding ShowUpdate}"
                          Margin="0,0,6,6" Command="{Binding UpdateSelectedCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Width="12" Height="12"
                                Data="M12,18A6,6 0 0,1 6,12C6,11 6.25,10.03 6.7,9.2L5.24,7.74C4.46,8.97 4,10.43 4,12A8,8 0 0,0 12,20V23L16,19L12,15M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12C18,13 17.75,14 17.3,14.8L18.76,16.26C19.54,15.03 20,13.57 20,12A8,8 0 0,0 12,4Z"/>
                      <TextBlock Text="{DynamicResource L.Update}" FontSize="11"/>
                    </StackPanel>
                  </Button>
                  <Button Content="{DynamicResource L.Remove}" Classes="danger mod-action"
                          IsVisible="{Binding ShowRemove}" Margin="0,0,0,6"
                          Command="{Binding RemoveSelectedCommand}"/>
                </WrapPanel>
              </Grid>
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalAlignment="Stretch"
                        ClipToBounds="True">
            <StackPanel Spacing="14" Margin="20,16,20,40">
              <Border Background="{DynamicResource Surface2Brush}"
                      CornerRadius="{DynamicResource RadiusMd}" Padding="14">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Grid.Row="0" Text="{DynamicResource L.Author}" Classes="muted" Width="88"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ModAuthorText}" TextWrapping="Wrap"/>
                  <TextBlock Grid.Row="1" Text="{DynamicResource L.Game}" Classes="muted"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModGameVersionText}" TextWrapping="Wrap"/>
                  <TextBlock Grid.Row="2" Text="{DynamicResource L.Updated}" Classes="muted"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ModLastUpdatedText}" TextWrapping="Wrap"/>
                </Grid>
              </Border>

              <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource L.Description}" Classes="section"/>
                <TextBlock Text="{Binding ModDescriptionText}" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="13" LineHeight="20"/>
              </StackPanel>

              <Border Background="{DynamicResource WarnSurfaceBrush}"
                      BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1"
                      CornerRadius="{DynamicResource RadiusMd}" Padding="12"
                      IsVisible="{Binding ShowUpdateNotice}">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding UpdateNoticeHeader}" FontWeight="SemiBold"
                             Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding UpdateNotesText}" TextWrapping="Wrap"
                             Foreground="{DynamicResource WarnMutedBrush}" FontSize="12"/>
                </StackPanel>
              </Border>

              <TextBlock Text="{DynamicResource L.UiConfigWarning}"
                         Foreground="{DynamicResource WarnBrush}"
                         IsVisible="{Binding HasUiConfigWarning}" TextWrapping="Wrap"
                         FontSize="12"/>

              <StackPanel IsVisible="{Binding ShowParameters}" Spacing="10">
                <TextBlock Text="{DynamicResource L.Configuration}" Classes="section"/>
                <ItemsControl ItemsSource="{Binding ParameterRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ParamRowViewModel">
                      <Border Background="{DynamicResource Surface2Brush}"
                              CornerRadius="{DynamicResource RadiusMd}"
                              Padding="12" Margin="0,0,0,8">
                        <StackPanel Spacing="6">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Description}" Classes="muted"
                                     FontSize="11" TextWrapping="Wrap"/>
                          <CheckBox IsVisible="{Binding IsBoolean}" IsChecked="{Binding BoolValue}"/>
                          <ComboBox IsVisible="{Binding IsSelect}" ItemsSource="{Binding Options}"
                                    SelectedItem="{Binding SelectedOption}" MinWidth="220"
                                    HorizontalAlignment="Stretch"/>
                          <TextBox IsVisible="{Binding IsText}" Text="{Binding TextValue}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Content="{DynamicResource L.Reset}" Command="{Binding ResetParametersCommand}"/>
                  <Button Content="{DynamicResource L.Save}" Classes="primary"
                          Command="{Binding SaveParametersCommand}"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </controls:MasterDetailPanel.DetailContent>
  </controls:MasterDetailPanel>
</UserControl>
