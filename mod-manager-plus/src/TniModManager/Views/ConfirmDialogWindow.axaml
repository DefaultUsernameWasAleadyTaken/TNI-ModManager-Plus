<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TniModManager.Views.ConfirmDialogWindow"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        SystemDecorations="Full">

  <Border Margin="12" Padding="20"
          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
          CornerRadius="10" Background="{DynamicResource SurfaceBrush}">
    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
      <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                 TextWrapping="Wrap"/>
      <TextBlock x:Name="MessageText" Grid.Row="1" Classes="muted"
                 TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                  HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Classes="secondary"
                Click="OnCancelClick" MinWidth="96" IsCancel="True"/>
        <Button x:Name="ConfirmButton" Classes="danger"
                Click="OnConfirmClick" MinWidth="96" IsDefault="True"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
