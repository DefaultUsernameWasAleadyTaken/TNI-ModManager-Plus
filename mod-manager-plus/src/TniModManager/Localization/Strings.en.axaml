<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
  <sys:String x:Key="L.Language">Language</sys:String>
  <sys:String x:Key="L.English">English</sys:String>
  <sys:String x:Key="L.Russian">Русский</sys:String>
  <sys:String x:Key="L.LaunchGame">Launch Game</sys:String>
  <sys:String x:Key="L.TabMods">Mods</sys:String>
  <sys:String x:Key="L.TabAliases">Aliases</sys:String>
  <sys:String x:Key="L.Library">Library</sys:String>
  <sys:String x:Key="L.Refresh">Refresh</sys:String>
  <sys:String x:Key="L.FilterAll">All</sys:String>
  <sys:String x:Key="L.FilterInstalled">Installed</sys:String>
  <sys:String x:Key="L.FilterAvailable">Available</sys:String>
  <sys:String x:Key="L.UpdateBadge">Update</sys:String>
  <sys:String x:Key="L.NothingSelected">Nothing selected</sys:String>
  <sys:String x:Key="L.PickMod">Pick a mod from the library to see details and actions.</sys:String>
  <sys:String x:Key="L.Download">Download</sys:String>
  <sys:String x:Key="L.Update">Update</sys:String>
  <sys:String x:Key="L.Remove">Remove</sys:String>
  <sys:String x:Key="L.Author">Author</sys:String>
  <sys:String x:Key="L.Game">Game</sys:String>
  <sys:String x:Key="L.Updated">Updated</sys:String>
  <sys:String x:Key="L.Description">Description</sys:String>
  <sys:String x:Key="L.UpdateAvailable">Update available · </sys:String>
  <sys:String x:Key="L.UiConfigWarning">This mod ships ui-config.ps1 — not executed; parameters come from metadata.yaml.</sys:String>
  <sys:String x:Key="L.Configuration">Configuration</sys:String>
  <sys:String x:Key="L.Reset">Reset</sys:String>
  <sys:String x:Key="L.Save">Save</sys:String>
  <sys:String x:Key="L.Aliases">Aliases</sys:String>
  <sys:String x:Key="L.NewAlias">New alias</sys:String>
  <sys:String x:Key="L.Delete">Delete</sys:String>
  <sys:String x:Key="L.SaveAliases">Save aliases</sys:String>
  <sys:String x:Key="L.PickAlias">Pick an alias to edit its command.</sys:String>
  <sys:String x:Key="L.Editor">Editor</sys:String>
  <sys:String x:Key="L.Name">Name</sys:String>
  <sys:String x:Key="L.Command">Command</sys:String>
  <sys:String x:Key="L.Apply">Apply</sys:String>
</ResourceDictionary>
