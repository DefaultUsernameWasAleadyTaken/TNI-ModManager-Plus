<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TniModManager.ViewModels"
             x:Class="TniModManager.Controls.AppHeader"
             x:DataType="vm:MainViewModel">

  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
    <StackPanel Grid.Column="0" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Mod Manager Plus" Classes="title"/>
        <Border Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
          <TextBlock Text="{Binding AppVersionBadgeText}" Classes="muted"
                     FontSize="11" FontWeight="SemiBold"/>
        </Border>
      </StackPanel>
      <TextBlock Text="Tower Networking Inc" Classes="muted"/>
      <TextBlock Text="{Binding StatusText}" Classes="muted" Margin="0,2,0,0"/>
    </StackPanel>

    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                VerticalAlignment="Top">
      <Button Classes="ghost" Command="{Binding ToggleThemeCommand}"
              ToolTip.Tip="{Binding ThemeToggleTooltip}" Padding="10">
        <Panel Width="18" Height="18">
          <PathIcon IsVisible="{Binding IsDarkTheme}"
                    Data="M12,18a6,6 0 1,0 0,-12a6,6 0 0,0 0,12M12,2V0M12,24v-2M4.22,4.22L2.81,2.81M21.19,21.19l-1.41,-1.41M2,12H0M24,12h-2M4.22,19.78l-1.41,1.41M21.19,2.81l-1.41,1.41"/>
          <PathIcon IsVisible="{Binding !IsDarkTheme}"
                    Data="M20.5,15.5A8.5,8.5 0 0,1 8.5,3.5A9,9 0 1,0 20.5,15.5Z"/>
        </Panel>
      </Button>

      <Button Classes="ghost" ToolTip.Tip="{DynamicResource L.Language}" Padding="10">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="{DynamicResource L.English}" Command="{Binding SelectLanguageCommand}"
                      CommandParameter="en"/>
            <MenuItem Header="{DynamicResource L.Russian}" Command="{Binding SelectLanguageCommand}"
                      CommandParameter="ru"/>
          </MenuFlyout>
        </Button.Flyout>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Width="18" Height="18"
                    Data="M12,2A10,10 0 1,0 12,22A10,10 0 0,0 12,2M4.2,9H7.1C7.4,6.8 8.1,4.9 9,3.7A8.1,8.1 0 0,0 4.2,9M4.2,15A8.1,8.1 0 0,0 9,20.3C8.1,19.1 7.4,17.2 7.1,15M9.1,9H14.9C14.5,6.2 13.3,4 12,4S9.5,6.2 9.1,9M9.1,15C9.5,17.8 10.7,20 12,20S14.5,17.8 14.9,15M16.9,9H19.8A8.1,8.1 0 0,0 15,3.7C15.9,4.9 16.6,6.8 16.9,9M16.9,15C16.6,17.2 15.9,19.1 15,20.3A8.1,8.1 0 0,0 19.8,15M3.9,11V13H20.1V11Z"/>
          <TextBlock Text="{Binding LanguageLabel}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>

      <Button Classes="warn" IsVisible="{Binding ShowAppUpdate}"
              Command="{Binding UpdateAppCommand}"
              ToolTip.Tip="{Binding AppUpdateButtonLabel}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <!-- Коробка/пакет со стрелкой вниз -->
          <PathIcon Width="16" Height="16"
                    Data="M12,2V11M8.5,7.5L12,11L15.5,7.5M5,13H19V21H5V13M5,13L12,16.5L19,13"/>
          <TextBlock Text="{Binding AppUpdateButtonLabel}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>

      <Button Classes="success" Command="{Binding LaunchGameCommand}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <PathIcon Width="16" Height="16" Data="M8,5V19L19,12Z"/>
          <TextBlock Text="{DynamicResource L.LaunchGame}"/>
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
