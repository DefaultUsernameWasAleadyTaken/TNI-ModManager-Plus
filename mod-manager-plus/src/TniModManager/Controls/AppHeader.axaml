<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TniModManager.ViewModels"
             x:Class="TniModManager.Controls.AppHeader"
             x:DataType="vm:MainViewModel">

  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
    <StackPanel Grid.Column="0" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Mod Manager Plus" Classes="title"/>
        <Border Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
          <TextBlock Text="{Binding AppVersionBadgeText}" Classes="muted"
                     FontSize="11" FontWeight="SemiBold"/>
        </Border>
      </StackPanel>
      <TextBlock Text="Tower Networking Inc" Classes="muted"/>
      <TextBlock Text="{Binding StatusText}" Classes="muted" Margin="0,2,0,0"/>
    </StackPanel>

    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                VerticalAlignment="Top">
      <!-- Тема: PNG с прозрачным фоном — солнце в тёмной, луна в светлой -->
      <Button Classes="header" Command="{Binding ToggleThemeCommand}"
              ToolTip.Tip="{Binding ThemeToggleTooltip}" Padding="12,10" MinWidth="40" MinHeight="40">
        <Panel Width="22" Height="22" Background="Transparent">
          <Image Width="22" Height="22" Stretch="Uniform"
                 IsVisible="{Binding IsDarkTheme}"
                 Source="avares://TNI-ModManager-Plus/Assets/Icons/theme-sun-on-dark.png"/>
          <Image Width="22" Height="22" Stretch="Uniform"
                 IsVisible="{Binding !IsDarkTheme}"
                 Source="avares://TNI-ModManager-Plus/Assets/Icons/theme-moon-on-light.png"/>
        </Panel>
      </Button>

      <Button Classes="header" ToolTip.Tip="{DynamicResource L.Language}"
              Padding="14,10" MinHeight="40">
        <Button.Flyout>
          <!-- Left: меню под кнопкой языка, не уезжает под тему -->
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuItem Command="{Binding SelectLanguageCommand}" CommandParameter="en">
              <MenuItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Image Width="20" Height="20" Stretch="Uniform"
                         VerticalAlignment="Center"
                         Source="avares://TNI-ModManager-Plus/Assets/Icons/flag-en.png"/>
                  <TextBlock Text="{DynamicResource L.English}" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>
              </MenuItem.Header>
            </MenuItem>
            <MenuItem Command="{Binding SelectLanguageCommand}" CommandParameter="ru">
              <MenuItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Image Width="20" Height="20" Stretch="Uniform"
                         VerticalAlignment="Center"
                         Source="avares://TNI-ModManager-Plus/Assets/Icons/flag-ru.png"/>
                  <TextBlock Text="{DynamicResource L.Russian}" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>
              </MenuItem.Header>
            </MenuItem>
          </MenuFlyout>
        </Button.Flyout>
        <TextBlock Text="{Binding LanguageLabel}" VerticalAlignment="Center" FontSize="13"/>
      </Button>

      <Button Classes="warn" IsVisible="{Binding ShowAppUpdate}"
              Command="{Binding UpdateAppCommand}"
              ToolTip.Tip="{Binding AppUpdateButtonLabel}"
              Padding="14,10" MinHeight="40">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Width="18" Height="18" Foreground="{DynamicResource OnAccentBrush}"
                    Data="M12,2V11M8.5,7.5L12,11L15.5,7.5M5,13H19V21H5V13M5,13L12,16.5L19,13"/>
          <TextBlock Text="{Binding AppUpdateButtonLabel}" VerticalAlignment="Center"
                     Foreground="{DynamicResource OnAccentBrush}" FontSize="13"/>
        </StackPanel>
      </Button>

      <Button Classes="success" Command="{Binding LaunchGameCommand}"
              Padding="14,10" MinHeight="40">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Width="18" Height="18" Foreground="{DynamicResource OnSuccessBrush}"
                    Data="M8,5V19L19,12Z"/>
          <TextBlock Text="{DynamicResource L.LaunchGame}" VerticalAlignment="Center"
                     Foreground="{DynamicResource OnSuccessBrush}" FontSize="13"/>
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
